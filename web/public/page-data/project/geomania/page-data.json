{"componentChunkName":"component---src-templates-project-js","path":"/project/geomania/","webpackCompilationHash":"","result":{"data":{"sampleProject":{"id":"2f056b35-bc34-5f2e-a6d7-2d43c01c91cf","publishedAt":"2016-02-16T21:15:00.000Z","categories":[{"_id":"8d5660f4-e63b-4567-a619-9d1fe59eb9e2","title":"Processing","url":"https://processing.org/"},{"_id":"2cff3f2e-dafc-4000-8769-4570209df594","title":"Java","url":"https://docs.oracle.com/javase/7/docs/technotes/guides/language/"},{"_id":"cf29dddd-dff3-4ad7-bd28-e0eb0206c284","title":"Game","url":null}],"relatedProjects":[{"title":"GeoWorld","_id":"9e278881-65f2-4839-960f-33d3e4a446db","slug":{"current":"geoworld"}}],"mainImage":{"crop":null,"hotspot":null,"asset":{"_id":"image-3e6c74a7a1f7e5cf1bfc12712da38e9b988fe4db-1200x623-png"},"alt":"A Screenshot taken from the game GeoMania"},"title":"GeoMania","slug":{"current":"geomania"},"_rawBody":[{"_key":"60e92a825b75","_type":"block","children":[{"_key":"3ad8617228640","_type":"span","marks":[],"text":""},{"_key":"89a53417e775","_type":"span","marks":["em"],"text":"GeoMania "},{"_key":"59ea765b1195","_type":"span","marks":[],"text":"is a space-themed multidirectional shooter game in the vein of Asteroids. It was given this name, due to the enemies having the shape of geometric forms."}],"markDefs":[],"style":"normal"},{"_key":"f77ecb2d59fc","_type":"block","children":[{"_key":"553e49230b650","_type":"span","marks":[],"text":"The player controls a spaceship with the arrow keys, and whenever the spaceship moves into a direction it fires projectiles. Whenever a projectile hits a geometric enemy, it is destroyed and splits into multiple smaller enemies of its shape. "},{"_key":"c96445799bb30","_type":"span","marks":[],"text":"On destroying enemies, the player is awarded points, and when all enemies are killed, he advances to the next level."}],"markDefs":[],"style":"normal"},{"_key":"6d664b48ee8e","_type":"block","children":[{"_key":"393e0a7dd1e90","_type":"span","marks":["em"],"text":"GeoMania "},{"_key":"11a1afbd7198","_type":"span","marks":[],"text":"was developed at the end of the first semester of my bachelor studies "},{"_key":"89ba3bc5cb82","_type":"span","marks":["30b97d7f90b1"],"text":"Media Technology"},{"_key":"287992e8ad89","_type":"span","marks":[],"text":" at the St. Pölten University of Applied Sciences. We started out learning to program with the programming language Processing, a language that aims to teach people how to code within the context of the visual arts. Processing is built on Java and therefore uses a very similar syntax."}],"markDefs":[{"_key":"30b97d7f90b1","_type":"link","href":"https://www.fhstp.ac.at/en/academic-studies-continuing-education/media-digital-technologies/media-technology"}],"style":"normal"},{"_key":"f571c72c4b69","_type":"block","children":[{"_key":"0171c4450fc90","_type":"span","marks":[],"text":"I decided that I wanted to use Processing to create a game that uses visual elements and is very lightweight, fun and easy to get into. The result was "},{"_key":"3dc33f4c9eb9","_type":"span","marks":["em"],"text":"GeoMania"},{"_key":"acbca188326b","_type":"span","marks":[],"text":", which you can download and enjoy by using the link below."}],"markDefs":[],"style":"normal"},{"_key":"b154ab550b50","_type":"block","children":[{"_key":"97da71f08d64","_type":"span","marks":[],"text":""},{"_key":"312ab3c41d9f","_type":"span","marks":["3fcb2aa1b48b"],"text":"Download GeoMania"},{"_key":"a5667f4bf826","_type":"span","marks":[],"text":"​"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"3fcb2aa1b48b","_type":"link","href":"https://cloudlogin03.world4you.com/index.php/s/C6LWdLzdyGAyVGc/download"}],"style":"normal"},{"_key":"7fe877077ce8","_type":"block","children":[{"_key":"b7f3f0c120e3","_type":"span","marks":[],"text":""},{"_key":"5dd4ef101265","_type":"span","marks":["fe093b28238a"],"text":"Sourcecode"},{"_key":"aee1aff250f5","_type":"span","marks":[],"text":""},{"_key":"c85e41039b0f","_type":"span","marks":[],"text":""},{"_key":"6af17df3d9a7","_type":"span","marks":[],"text":""}],"level":1,"listItem":"bullet","markDefs":[{"_key":"3fcb2aa1b48b","_type":"link","href":"https://cloudlogin03.world4you.com/index.php/s/C6LWdLzdyGAyVGc/download"},{"_key":"fe093b28238a","_type":"link","href":"https://github.com/matzekFloyd/GeoMania"}],"style":"normal"}],"members":[{"_key":"523e1356950a","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-8bae5c3a89f1408962d1c67797372f4628127b36-960x1280-jpg"}},"name":"Mathias Mayrhofer"},"roles":["developer"]}]}},"pageContext":{"isCreatedByStatefulCreatePages":false,"id":"2f056b35-bc34-5f2e-a6d7-2d43c01c91cf"}}}