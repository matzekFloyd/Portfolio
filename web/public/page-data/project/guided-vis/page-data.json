{"componentChunkName":"component---src-templates-project-js","path":"/project/guided-vis/","webpackCompilationHash":"","result":{"data":{"sampleProject":{"id":"33e90b8b-42f6-544a-aa04-654cc04dbb52","publishedAt":"2019-07-10T13:30:10.000Z","categories":[{"_id":"96a2fd48-14c8-4db0-9cca-317f2f3ae209","title":"React","url":"https://reactjs.org/"},{"_id":"3adcefab-d50b-4a65-a8a5-0aa2c6faf0e6","title":"JavaScript","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript"},{"_id":"79b5c44f-edda-4569-8a03-3c35c95e0120","title":"Data visualization","url":null},{"_id":"35eb651e-e452-485d-abd7-8327af9376a2","title":"Educational","url":null}],"relatedProjects":[{"title":"VisOnboarding","_id":"5c1d8cdb-0a4b-474b-ae3c-1cf831dc6556","slug":{"current":"visonboarding"}}],"mainImage":{"crop":null,"hotspot":null,"asset":{"_id":"image-33dc130fc0d599046098bf1c58d36fe6b0a8158c-2418x1056-png"},"alt":"Placeholder"},"title":"Guided Vis","slug":{"current":"guided-vis"},"_rawBody":[{"_key":"cfcf3f7c3d52","_type":"block","children":[{"_key":"bf79b12e1903","_type":"span","marks":[],"text":"In the second semester of my master studies at the University of Applied Sciences in St.Pölten I had the pleasure to support the work on a project for the research group "},{"_key":"26b9573c1eaa","_type":"span","marks":["46d081049d34"],"text":"Media Computing"},{"_key":"deb4a6734d5c","_type":"span","marks":[],"text":""},{"_key":"eb621727d849","_type":"span","marks":[],"text":". The goal of this project was to create a guided, interactive step-by-step instruction that explains how a data visualization is constructed."}],"markDefs":[{"_key":"46d081049d34","_type":"link","href":"https://mc.fhstp.ac.at/"}],"style":"normal"},{"_key":"60c18fe5f2bc","_type":"block","children":[{"_key":"fbd0542e9ab6","_type":"span","marks":[],"text":"To achieve this, I created a web application with the JavaScript framework React, that shows and explains the structure of a bar chart in 5 single consecutive steps. The application includes 2 modes, which contain different representations and explanations of the data. "}],"markDefs":[],"style":"normal"},{"_key":"d5d3b5d9ec2e","_type":"block","children":[{"_key":"cd8db8259f39","_type":"span","marks":[],"text":"The \"Abstract\" mode shows a bar chart based on abstract data, while the \"Concrete\" mode uses the results of the 2019 EU elections as a basis for the visualization. In both views, 5 different steps, which are interactive and selectable, show different phases of the visualization. "}],"markDefs":[],"style":"normal"},{"_key":"e7873f8843b9","_type":"block","children":[{"_key":"4da7289c51b7","_type":"span","marks":[],"text":"​"},{"_key":"586fa661d49d","_type":"span","marks":[],"text":""},{"_key":"2200e68e4a76","_type":"span","marks":["f0779084e912"],"text":"See GuidedVis"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"f0779084e912","_type":"link","href":"http://it181508.students.fhstp.ac.at/understanding-barcharts/"}],"style":"normal"},{"_key":"f3f6e43f21e9","_type":"block","children":[{"_key":"217355ed5889","_type":"span","marks":["9baf8966f448"],"text":"Sourcecode"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"9baf8966f448","_type":"link","href":"https://github.com/matzekFloyd/GuidedValid"}],"style":"normal"}],"members":[{"_key":"5433dc6c3309","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-8bae5c3a89f1408962d1c67797372f4628127b36-960x1280-jpg"}},"name":"Mathias Mayrhofer"},"roles":["developer"]}]}},"pageContext":{"isCreatedByStatefulCreatePages":false,"id":"33e90b8b-42f6-544a-aa04-654cc04dbb52"}}}