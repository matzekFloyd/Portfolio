{"componentChunkName":"component---src-templates-project-js","path":"/project/marble-falls/","webpackCompilationHash":"","result":{"data":{"sampleProject":{"id":"19e20651-c0f9-519b-acb8-359efdace4ea","publishedAt":"2017-09-16T11:00:00.000Z","categories":[{"_id":"8d5660f4-e63b-4567-a619-9d1fe59eb9e2","title":"Processing","url":"https://processing.org/"},{"_id":"dcd1af2b-3447-4dd3-b96b-463a82aa15c3","title":"Arduino","url":"https://www.arduino.cc/"},{"_id":"cf29dddd-dff3-4ad7-bd28-e0eb0206c284","title":"Game","url":null}],"relatedProjects":[],"mainImage":{"crop":null,"hotspot":null,"asset":{"_id":"image-e62cfe513ef8b252e82475ee02e6327cf7d35807-1044x800-png"},"alt":"Placeholder"},"title":"Marble Falls","slug":{"current":"marble-falls"},"_rawBody":[{"_key":"d92d7314d6c3","_type":"block","children":[{"_key":"6585850851ff","_type":"span","marks":["em"],"text":"Marble Falls "},{"_key":"f839964b2814","_type":"span","marks":[],"text":"is a game that uses a touchscreen as its main control element."}],"markDefs":[],"style":"normal"},{"_key":"d8c72fe28f4d","_type":"block","children":[{"_key":"d2f53323da16","_type":"span","marks":[],"text":"By pressing the touch screen balls (or: marbles) are created. Each of these marbles has a specificly set fall velocity. Over the course of the game colored platforms (so called edges) appear. These edges are moving from right to left or top to bottom. "}],"markDefs":[],"style":"normal"},{"_key":"ea5564777e37","_type":"block","children":[{"_key":"6aea363996ae","_type":"span","marks":[],"text":"The marbles can collide with these platforms and depending on the platform type (represented by its color) a collision causes different events. A green platform adds points to the user score, while a red platform subtracts points. In both cases the marble disappears after colliding with the platform. However, a blue platform causes the marble to bounce off without effecting the score. Finally, if a marble hits the edge of the game window 3 times, it is removed from the game. "}],"markDefs":[],"style":"normal"},{"_key":"b8112de4d3bc","_type":"youtube","url":"https://www.youtube.com/watch?v=PFyDNJgN31A"},{"_key":"e90cd86d7d77","_type":"block","children":[{"_key":"94f9fb92bd81","_type":"span","marks":[],"text":"For the implementation of "},{"_key":"0d0ae03d3572","_type":"span","marks":["em"],"text":"Marble Falls"},{"_key":"87a1f29fe455","_type":"span","marks":[],"text":" the following components were used:  "},{"_key":"6bf7b4478ccb","_type":"span","marks":["5ef980a4b700"],"text":"Arduino Uno R3"},{"_key":"c507b2d046bc","_type":"span","marks":[],"text":" and a 3.2 inch tft lcd Shield with one touch panel. The program was written in Arduino 1.8.4 and Processing 3.3.6."}],"markDefs":[{"_key":"5ef980a4b700","_type":"link","href":"https://store.arduino.cc/arduino-uno-rev3"}],"style":"normal"},{"_key":"01765f150c78","_type":"block","children":[{"_key":"9cba933e15df","_type":"span","marks":["9af586c87ebb"],"text":"Sourcecode"},{"_key":"c68e486c9ad9","_type":"span","marks":[],"text":"​ "}],"level":1,"listItem":"bullet","markDefs":[{"_key":"9af586c87ebb","_type":"link","href":"https://github.com/matzekFloyd/MarbleFalls"}],"style":"normal"}],"members":[{"_key":"04db5d205f0d","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-8bae5c3a89f1408962d1c67797372f4628127b36-960x1280-jpg"}},"name":"Mathias Mayrhofer"},"roles":["developer"]}]}},"pageContext":{"isCreatedByStatefulCreatePages":false,"id":"19e20651-c0f9-519b-acb8-359efdace4ea"}}}