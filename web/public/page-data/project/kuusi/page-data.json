{"componentChunkName":"component---src-templates-project-js","path":"/project/kuusi/","webpackCompilationHash":"","result":{"data":{"sampleProject":{"id":"1d164118-8bc8-58ac-92b6-05a368a2c6f5","publishedAt":"2018-01-30T23:00:00.000Z","categories":[{"_id":"71de6812-fd07-47f3-b0f5-90ad2089b12c","title":"Swift","url":"https://developer.apple.com/swift/"},{"_id":"7d6f779c-a104-4492-b0bb-a8fbb2afca2e","title":"iOS","url":null},{"_id":"35eb651e-e452-485d-abd7-8327af9376a2","title":"Educational","url":null}],"relatedProjects":[],"mainImage":{"crop":null,"hotspot":null,"asset":{"_id":"image-e0b3932b70f2a25f4d58d7fec54e4bf24fc6e1aa-1182x565-png"},"alt":"Placeholder"},"title":"Kuusi","slug":{"current":"kuusi"},"_rawBody":[{"_key":"301aacadf03a","_type":"block","children":[{"_key":"7ef693f6c0c8","_type":"span","marks":["em"],"text":"Kuusi "},{"_key":"d24128195504","_type":"span","marks":[],"text":"is an iOS application that was developed in a group of six people over the course of a semester. I"},{"_key":"ad32ed6644c7","_type":"span","marks":[],"text":" was mainly active as developer and tester of the application."}],"markDefs":[],"style":"normal"},{"_key":"c47d9e9bb65c","_type":"figure","alt":"A user navigates through the map view of Kuusi","asset":{"_ref":"image-7f497023a7c6e0a80f77c9ce0c46e10c999584db-1030x611-png","_type":"reference"},"caption":"A user navigates through the map view of Kuusi"},{"_key":"401c86c50e1b","_type":"block","children":[{"_key":"3d6ebf759eab","_type":"span","marks":["em"],"text":"Kuusi "},{"_key":"7f7200d9e074","_type":"span","marks":[],"text":"is an Augmented Reality (AR) iOS Sightseeing App. Users explore Vienna's city center in an interactive way, and information about various points of interest (POI) are displayed virtually using AR."}],"markDefs":[],"style":"normal"},{"_key":"b8a66951b3d1","_type":"block","children":[{"_key":"d7d470f2fe97","_type":"span","marks":[],"text":"The user selects a predetermined route on a map, on which several POIs (museums, historical buildings, restaurants, etc.) are located. With the help of AR, virtual information about the POIs is displayed to the user."}],"markDefs":[],"style":"normal"},{"_key":"ab17205a1c88","_type":"figure","alt":"Taking a picture next to an object added with augmented reality","asset":{"_ref":"image-252eec6698cea5e0cba9ac98085dd69e15309804-1030x699-png","_type":"reference"},"caption":"Taking a picture next to an object added with augmented reality"},{"_key":"84a6e1d4824d","_type":"block","children":[{"_key":"b17e19fa1ec1","_type":"span","marks":[],"text":"An additional feature of "},{"_key":"fdbdb5d6934e","_type":"span","marks":["em"],"text":"Kuusi "},{"_key":"63039eb07418","_type":"span","marks":[],"text":"is MEMORIES: A famous Austrian personality (e.g. Sissi) is shown as a 3D model in the real environment on the display. Then, you can position yourself next to the personality and take a unique selfie. These famous personalities appear unannounced during a selected sightseeing tour."}],"markDefs":[],"style":"normal"},{"_key":"5797e91fd3be","_type":"block","children":[{"_key":"cad66bb9401f","_type":"span","marks":[],"text":"As far as the implementation of the application was concerned, all options were left open to us. The team decided unanimously to write an iOS application, in order to get familiar with the programming language Swift and Apple's AR kit."}],"markDefs":[],"style":"normal"},{"_key":"15726bf4d1cd","_type":"block","children":[{"_key":"276541175ac6","_type":"span","marks":["4d2fcfdc8ddd"],"text":"Imagevideo"},{"_key":"72c8afbf916a","_type":"span","marks":[],"text":"​ "}],"level":1,"listItem":"bullet","markDefs":[{"_key":"4d2fcfdc8ddd","_type":"link","href":"https://drive.google.com/file/d/1Ry1hHF4TxfsJd67FzDEYDBSgRd7pZFD9/view"}],"style":"normal"}],"members":[{"_key":"d3c9796904c5","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-8bae5c3a89f1408962d1c67797372f4628127b36-960x1280-jpg"}},"name":"Mathias Mayrhofer"},"roles":["developer"]},{"_key":"1ccf556b6bdd","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-e14285ce2c13548956c7a411b1857b8615fb520a-512x512-png"}},"name":"Tina Grimm"},"roles":["designer"]},{"_key":"11666eb40322","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-e14285ce2c13548956c7a411b1857b8615fb520a-512x512-png"}},"name":"Mouaman Gazar"},"roles":["designer"]},{"_key":"3d1caa36aab5","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-110b379cde725c6a187e71c959cb2a274015d8d5-1100x1125-jpg"}},"name":"Lionel Koller"},"roles":["developer"]},{"_key":"5b1f0c99dd52","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-e14285ce2c13548956c7a411b1857b8615fb520a-512x512-png"}},"name":"Raphael Paolo Graselli"},"roles":["designer"]},{"_key":"df77a841f65e","person":{"image":{"crop":null,"hotspot":null,"asset":{"_id":"image-e14285ce2c13548956c7a411b1857b8615fb520a-512x512-png"}},"name":"Julian Haunold"},"roles":["developer"]}]}},"pageContext":{"isCreatedByStatefulCreatePages":false,"id":"1d164118-8bc8-58ac-92b6-05a368a2c6f5"}}}